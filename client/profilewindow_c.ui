  <property name="styleSheet">
   <string notr="true">
#centralwidget {
    background-image: url(":/wallhaven-49kq3d.jpg");
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
}

QTabWidget {
    background: transparent;
}

QTabWidget::pane {
    border: 1px solid rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.55);
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    margin-top: -1px;
    padding: 20px;
}

QTabBar {
    background: transparent;
    qproperty-drawBase: 0;
}

/* تقسیم متوازن و خودکار تب ها در تمام عرض پنل */
QTabBar::tab {
    background: rgba(30, 41, 59, 0.85);
    border: 1px solid rgba(30, 41, 59, 0.9);
    border-bottom: none;
    color: #f8fafc;
    min-width: 260px; /* افزایش ابعاد تب ها متناسب با پنل بزرگتر */
    padding: 12px 0px;
    font-size: 15px;
    font-weight: bold;
    font-family: "Segoe UI", "Tahoma", sans-serif;
    text-align: center;
    margin-right: -1px;
}

/* اصلاح گردی گوشه بالا سمت راست برای تب اول (RTL) */
QTabBar::tab:first {
    border-top-left-radius: 20px;
    border-top-right-radius: 0px;
}

/* اصلاح گردی گوشه بالا سمت چپ برای تب آخر (RTL) */
QTabBar::tab:last {
    border-top-right-radius: 20px;
    border-top-left-radius: 0px;
    margin-right: 0px;
}

QTabBar::tab:selected {
    background: rgba(255, 255, 255, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-bottom: none;
    color: #0f172a;
}

QTabBar::tab:hover {
    background: rgba(30, 41, 59, 0.95);
    color: #fde047;
}

QTableWidget {
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid rgba(30, 41, 59, 0.3);
    gridline-color: rgba(30, 41, 59, 0.15);
    border-radius: 14px;
    color: #0f172a;
    font-size: 14px;
    font-family: "Segoe UI", "Tahoma", sans-serif;
}

QHeaderView {
    background-color: #1e293b;
    border: none;
}

QHeaderView::section {
    background-color: #1e293b;
    color: #ffffff;
    padding: 12px 0px;
    font-weight: bold;
    font-size: 14px;
    border: none;
    text-align: center;
}

QTableWidget::item {
    padding: 10px;
    color: #0f172a;
}

QTableWidget::item:hover {
    background-color: rgba(30, 41, 59, 0.1);
}

QPushButton {
    background-color: #1e293b;
    color: #ffffff;
    border: 1px solid #0f172a;
    border-radius: 12px;
    padding: 12px 24px;
    font-weight: bold;
    font-size: 15px;
    font-family: "Segoe UI", "Tahoma", sans-serif;
}

QPushButton:hover {
    background-color: #0f172a;
    color: #fde047;
    border: 1px solid #020617;
}

QPushButton#backButton {
    background-color: #1e293b;
    color: #ffffff;
    border: 1px solid #0f172a;
}

QPushButton#backButton:hover {
    background-color: #0f172a;
    color: #fde047;
}

QLineEdit {
    background: rgba(255, 255, 255, 0.85);
    border: 1.5px solid rgba(30, 41, 59, 0.4);
    border-radius: 10px;
    padding: 12px 14px;
    color: #0f172a;
    font-size: 14px;
}

QLineEdit:focus {
    background: #ffffff;
    border: 2px solid #1e293b;
}

#accountInfoTab QLabel, #changePasswordTab QLabel {
    color: #0f172a;
    font-size: 15px;
    font-weight: bold;
}</string>
