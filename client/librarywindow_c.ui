    background-color: rgba(0, 0, 0, 120);
    color: white;
    border: 1px solid rgba(255, 255, 255, 30);
    border-radius: 10px;
    padding: 5px;
    font-size: 14px;
}

QListWidget::item:selected {
    background-color: rgba(45, 95, 139, 200);
    border-radius: 5px;
}
