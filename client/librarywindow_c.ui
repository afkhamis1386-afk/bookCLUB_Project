    font-size: 14px;
    font-weight: bold;
    margin-right: 2px;
	width: 457px; 
    text-align: center;
}
QTabBar::tab:selected {
    background: #2d5f8b;
    border: 1px solid rgba(255, 255, 255, 50);
    border-bottom: none;
}
