  <property name="styleSheet">
   <string notr="true">QTabWidget {
    background: transparent;
}

QTabWidget::pane {
    border: 2px solid rgba(112, 146, 190, 0.8);
    background: rgba(255, 255, 255, 0.65);
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
}

QTabBar {
    background: transparent;
    qproperty-drawBase: 0;
}

QTabBar::tab {
    background: rgba(255, 255, 255, 0.35);
    padding: 12px 20px;
    border: 2px solid rgba(112, 146, 190, 0.8);
    border-bottom: none;
    color: #2c3e50;
    font-size: 14px;
    font-weight: bold;
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;, sans-serif;
    text-align: center;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
}

QTabBar::tab:first {
    border-top-left-radius: 20px;
}

QTabBar::tab:last {
    border-top-right-radius: 20px;
}

QTabBar::tab:selected {
    background: rgba(255, 255, 255, 0.65);
    border: 2px solid rgba(112, 146, 190, 0.8);
    border-bottom: none;
    color: #111e2e;
}

QTabBar::tab:hover {
    background: rgba(255, 255, 255, 0.5);
    color: #000000;
}

QListWidget {
    background: rgba(255, 255, 255, 0.45);
    border: 2px solid rgba(112, 146, 190, 0.7);
    border-radius: 14px;
    color: #2c3e50;
    font-size: 13px;
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;, sans-serif;
}

QListWidget::item {
    color: #2c3e50;
    border-radius: 8px;
}

QListWidget::item:hover {
    background-color: rgba(112, 146, 190, 0.15);
}

QListWidget::item:selected {
    background-color: rgba(112, 146, 190, 0.3);
    color: #111e2e;
}

QListWidget QScrollBar:horizontal {
    border: none;
    background: rgba(112, 146, 190, 0.2);
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

QListWidget QScrollBar::handle:horizontal {
    background: #a6c8e0;
    border-radius: 5px;
}

QListWidget QScrollBar::handle:horizontal:hover {
    background: #7baad0;
}

QListWidget QScrollBar::add-line:horizontal,
QListWidget QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
}

QListWidget QScrollBar::add-page:horizontal,
QListWidget QScrollBar::sub-page:horizontal {
    background: none;
}

QListWidget QScrollBar:vertical {
    border: none;
    background: rgba(112, 146, 190, 0.2);
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

QListWidget QScrollBar::handle:vertical {
    background: #a6c8e0;
    border-radius: 5px;
}

QListWidget QScrollBar::handle:vertical:hover {
    background: #7baad0;
}

QListWidget QScrollBar::add-line:vertical,
QListWidget QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

QListWidget QScrollBar::add-page:vertical,
QListWidget QScrollBar::sub-page:vertical {
    background: none;
}
QPushButton {
    background-color: #2c3e50;
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 10px;
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;;
    font-size: 14px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #34495e;
    color: #d4af37;
    font-weight: bold;
}

QPushButton:pressed {
    background-color: #1a252f;
}

QPushButton#backButton {
   background-color: #2c3e50;
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 10px;
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;;
    font-size: 14px;
    font-weight: bold;
}

QPushButton#backButton:hover {
    background-color: #34495e;
    color: #d4af37;
    font-weight: bold;
}

QLineEdit {
    background: rgba(255, 255, 255, 0.6);
    border: 1.5px solid rgba(112, 146, 190, 0.7);
    border-radius: 10px;
    color: #2c3e50;
    font-size: 14px;
}

QLineEdit:focus {
    background: rgba(255, 255, 255, 0.85);
    border: 2px solid #7092be;
}</string>
