}

QTabWidget::pane {
    border: 1px solid rgba(255, 255, 255, 50);
    background: rgba(0, 0, 0, 100);
    border-radius: 10px;
    margin-top: -1px;
}

QTabBar::tab {
    background: rgba(45, 95, 139, 150);
    color: white;
    padding: 10px 20px;
    border-top-left-radius: 10px;
