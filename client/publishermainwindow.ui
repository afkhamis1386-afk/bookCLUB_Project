   <string notr="true">
QMainWindow {
    background-image: url(&quot;:/wallhaven-49kq3d.jpg&quot;);
    background-position: center;
    background-repeat: no-repeat;
}

QFrame#mainFrame {
    background-color: rgba(255, 255, 255, 0.42); 
    border: 1px solid rgba(255, 255, 255, 0.6);  
    border-radius: 24px;                          
}

QTabWidget::pane {
    border: none; 
    background: transparent;
}

QTabBar::tab {
    background-color: rgba(255, 255, 255, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-bottom: none;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    padding: 8px 16px;
    color: #34495e;
    font-weight: bold;
    font-size: 13px;
    font-family: &quot;Segoe UI&quot;, &quot;Vazir&quot;, &quot;Tahoma&quot;;
}

QTabBar::tab:selected {
 
    background-color: rgba(212, 225, 237, 0.65); 
    border: 1px solid rgba(255, 255, 255, 0.7);
    color: #1a252f;
}

QTabBar QToolButton {
    background-color: rgba(255, 255, 255, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 6px;
    margin: 2px;
}

QTabBar QToolButton:hover {
    background-color: rgba(212, 225, 237, 0.7);
}
QWidget#dashboardTab, QWidget#myBooksTab, QWidget#publisherProfileTab {
    background: transparent;
}

QLabel {
    color: #2c3e50;
    font-family: &quot;Segoe UI&quot;, &quot;Vazir&quot;, &quot;Tahoma&quot;;
    font-size: 13px;
    font-weight: 600;
    padding: 8px 12px;
    background-color: rgba(255, 255, 255, 0.18); 
    border: 1px dashed rgba(255, 255, 255, 0.45); 
    border-radius: 10px;                         
}
QPushButton {
    background-color: rgba(255, 255, 255, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 12px;
    color: #2c3e50;
    font-family: &quot;Segoe UI&quot;, &quot;Vazir&quot;, &quot;Tahoma&quot;;
    font-weight: bold;
    font-size: 13px;
    padding: 10px 20px;
}

QPushButton:hover {
    background-color: rgba(212, 225, 237, 0.6); 
    border: 1px solid rgba(255, 255, 255, 0.8);
    color: #1a252f;
}


QListWidget, QListView {
    background-color: rgba(200, 214, 229, 0.22); 
    border: 1px solid rgba(255, 255, 255, 0.5);   
    border-radius: 14px;
    color: #2c3e50;
    font-family: &quot;Segoe UI&quot;, &quot;Vazir&quot;, &quot;Tahoma&quot;;
    padding: 6px;
}

QListWidget::item:hover, QListView::item:hover {
    background-color: rgba(255, 255, 255, 0.35);
    border-radius: 8px;
    color: #1a252f;
}

QTableWidget, QTableView {
    background-color: rgba(200, 214, 229, 0.22); 
    border: 1px solid rgba(255, 255, 255, 0.5);
    gridline-color: rgba(255, 255, 255, 0.2);
    border-radius: 14px;
    color: #2c3e50;
}
QHeaderView::section {
    background-color: rgba(212, 225, 237, 0.5);  
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 6px;
    font-weight: bold;
    color: #2c3e50;
}

QScrollBar:vertical, QScrollBar:horizontal {
    border: none;
    background: rgba(255, 255, 255, 0.1);
    width: 8px;
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: rgba(212, 225, 237, 0.7); 
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::add-line, QScrollBar::sub-line {
    border: none;
    background: none;
}</string>
