  <property name="styleSheet">
   <string notr="true">
#centralwidget {
    background-image: url(&quot;:/wallhaven-49kq3d.jpg&quot;);
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
}

QTabWidget {
    background: transparent;
}

QTabWidget::pane {
    border: 1px solid rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.55);
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    margin-top: -1px;
    padding: 15px;
}

QTabBar {
    background: transparent;
    qproperty-drawBase: 0;
}

/* تنظیم دقیق عرض تب ها برای پوشش کامل و متوازن */
QTabBar::tab {
    background: rgba(30, 41, 59, 0.85);
    border: 1px solid rgba(30, 41, 59, 0.9);
    border-bottom: none;
    color: #f8fafc;
    width: 286px;
    padding: 12px 0px;
    font-size: 14px;
    font-weight: bold;
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;, sans-serif;
    text-align: center;
    margin-right: -1px;
}

/* گوشه بالا سمت راست برای تب اول (RTL) */
QTabBar::tab:first {
    border-top-right-radius: 20px;
    border-top-left-radius: 0px;
}

/* گوشه بالا سمت چپ برای تب آخر (RTL) */
QTabBar::tab:last {
    border-top-left-radius: 20px;
    border-top-right-radius: 0px;
    margin-right: 0px;
}

QTabBar::tab:selected {
    background: rgba(255, 255, 255, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-bottom: none;
    color: #0f172a;
}

QTabBar::tab:hover {
    background: rgba(30, 41, 59, 0.95);
    color: #fde047;
}

QTableWidget, QListWidget {
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid rgba(30, 41, 59, 0.3);
    gridline-color: rgba(30, 41, 59, 0.15);
    border-radius: 12px;
    color: #0f172a;
    font-size: 13px;
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;, sans-serif;
}

QHeaderView {
    background-color: #1e293b;
    border: none;
}

QHeaderView::section {
    background-color: #1e293b;
    color: #ffffff;
    padding: 8px 0px;
    font-weight: bold;
    font-size: 13px;
    border: none;
    text-align: center;
}

QTableWidget::item, QListWidget::item {
    padding: 6px;
    color: #0f172a;
}

/* استایل یکدست برای تمام دکمه ها */
QPushButton {
    background-color: #1e293b;
    color: #ffffff;
    border: 1px solid #0f172a;
    border-radius: 12px;
    padding: 10px 18px;
    font-weight: bold;
    font-size: 14px;
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;, sans-serif;
}

/* تغییر رنگ متن تمام دکمه ها به طلایی در حالت Hover */
QPushButton:hover {
    background-color: #0f172a;
    color: #fde047;
    border: 1px solid #020617;
}

QLabel {
    color: #0f172a;
    font-size: 14px;
    font-weight: bold;
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;, sans-serif;
}
</string>
