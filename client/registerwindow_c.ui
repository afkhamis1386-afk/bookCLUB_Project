  <property name="styleSheet">
   <string notr="true">
#RegisterWindow_c, #centralwidget {
    border-image: url(:/wallhaven-49kq3d.jpg) 0 0 0 0 stretch stretch;
}

QFrame#mainFrame {
    background-color: rgba(255, 255, 255, 120);
    border: 1px solid rgba(255, 255, 255, 180);
    border-radius: 20px;
}


QStackedWidget#publisherFieldsStack, 
#publisherFieldsStack QWidget, 
#publisherFieldsStack #page, 
#publisherFieldsStack #page_2, 
#publisherFieldsStack #page_3 {
    background: transparent;
    border: none;
}


QLineEdit, 
#publisherFieldsStack QLineEdit {
    background-color: rgba(255, 255, 255, 200); 
    border: 1px solid rgba(44, 62, 80, 60);    
    border-radius: 8px;                       
    padding: 6px 10px;
    color: #2c3e50;
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;;
    font-size: 11pt;
}


QLineEdit:focus, 
#publisherFieldsStack QLineEdit:focus {
    border: 2px solid #2c3e50;
    background-color: #ffffff;
}


QTextEdit#shortDescriptionTextEdit {
    background-color: rgba(255, 255, 255, 200);
    border: 1px solid rgba(44, 62, 80, 60);
    border-radius: 8px;
    color: #2c3e50;
}
QTextEdit#shortDescriptionTextEdit:focus {
    border: 2px solid #2c3e50;
    background-color: #ffffff;
}


QGroupBox#roleGroupBox {
    background-color: rgba(255, 255, 255, 80);
    border: 1px solid rgba(44, 62, 80, 40);
    border-radius: 10px;
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;;
    font-weight: bold;
    color: #2c3e50;
}
QGroupBox#roleGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top right;
    padding: 0 10px;
}
QRadioButton {
    color: #2c3e50;
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;;
    font-weight: bold;
    background: transparent;
}


QPushButton#registerButton {
    background-color: #2c3e50;
    color: #ffffff;
    border-radius: 8px;
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;;
    font-size: 11pt;
    font-weight: bold;
    padding: 8px;
    min-height: 35px;
}
QPushButton#registerButton:hover {
    background-color: #34495e;
}


QPushButton#backToLoginButton {
    background-color: transparent;
    color: #2c3e50;
    border: none;
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;;
    font-size: 10pt;
    text-decoration: underline;
    min-height: 30px;
}
QPushButton#backToLoginButton:hover {
    color: #d4af37;
}</string>
