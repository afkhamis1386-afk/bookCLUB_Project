  <property name="styleSheet">
   <string notr="true">
#RegisterWindow_c, #centralwidget {
    border-image: url(&quot;:/wallhaven-49kq3d.jpg&quot;) 0 0 0 0 stretch stretch;
}

QFrame#mainFrame {
    background-color: rgba(255, 255, 255, 150);
    border: 1px solid rgba(255, 255, 255, 180);
    border-radius: 20px;
}

QGroupBox#publisherFieldsGroupBox, QGroupBox#roleGroupBox {
    background-color: rgba(255, 255, 255, 90);
    border: 1px solid rgba(44, 62, 80, 80);
    border-radius: 10px;
    margin-top: 10px;
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;;
    font-weight: bold;
    color: #000000;
}

QGroupBox#publisherFieldsGroupBox::title, QGroupBox#roleGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top right;
    padding: 0 8px;
}

QLineEdit,
#publisherFieldsGroupBox QLineEdit {
    background-color: #ffffff;
    border: 1px solid rgba(44, 62, 80, 100);
    border-radius: 6px;
    padding: 4px 8px;
    color: #000000;
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;;
    font-size: 10pt;
}

QLineEdit:focus,
#publisherFieldsGroupBox QLineEdit:focus {
    border: 2px solid #2c3e50;
    background-color: #ffffff;
}

QTextEdit#shortDescriptionTextEdit {
    background-color: #ffffff;
    border: 1px solid rgba(44, 62, 80, 100);
    border-radius: 6px;
    color: #000000;
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;;
    font-size: 10pt;
    padding: 4px;
    max-height: 40px;
}

QTextEdit#shortDescriptionTextEdit:focus {
    border: 2px solid #2c3e50;
    background-color: #ffffff;
}

QRadioButton {
    color: #000000;
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;;
    font-weight: bold;
    background: transparent;
}

QPushButton#registerButton {
    background-color: #2c3e50;
    color: #ffffff;
    border-radius: 8px;
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;;
    font-size: 11pt;
    font-weight: bold;
    padding: 6px;
    min-height: 35px;
}

QPushButton#registerButton:hover {
    background-color: #34495e;
}

QPushButton#backToLoginButton {
    background-color: transparent;
    color: #2c3e50;
    border: none;
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;;
    font-size: 10pt;
    text-decoration: underline;
    min-height: 25px;
}

QPushButton#backToLoginButton:hover {
    color: #d4af37;
}</string>
