  <property name="styleSheet">
   <string notr="true">#centralwidget {
    background-image: url(&quot;:/wallhaven-49kq3d.jpg&quot;) 0 0 0 0 stretch stretch;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
}

QTabWidget {
    background: transparent;
}

QTabWidget::pane {
    border: 2px solid rgba(112, 146, 190, 0.8); 
    background: rgba(255, 255, 255, 0.65); 
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    margin-top: -2px; 
    padding: 20px;
border-radius: 20px;
}

QTabBar {
    background: transparent;
    qproperty-drawBase: 0;
    margin: 0px;
    padding: 0px;
}

QTabBar::tab {
    background: rgba(255, 255, 255, 0.35);  
    border: 2px solid rgba(112, 146, 190, 0.8);
    border-bottom: none;
    color: #2c3e50; 

    padding: 12px 0px;
    font-size: 14px;
    font-weight: bold;
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;, sans-serif;
    text-align: center;
    margin-right: -2px;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
}

QTabBar::tab:first {
    border-top-left-radius: 20px;
}

QTabBar::tab:last {
    border-top-right-radius: 20px;
    margin-right: 0px;
}

QTabBar::tab:selected {
    background: rgba(255, 255, 255, 0.65);
    border: 2px solid rgba(112, 146, 190, 0.8);
    border-bottom: none;
    color: #111e2e;
}

QTabBar::tab:hover {
    background: rgba(255, 255, 255, 0.5);
    color: #000000;
}

QTableWidget {
    background: rgba(255, 255, 255, 0.45);  
    border: 2px solid rgba(112, 146, 190, 0.7);
    gridline-color: rgba(112, 146, 190, 0.25);
    border-radius: 14px;
    color: #2c3e50;
    font-size: 13px;
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;, sans-serif;
}

QTableWidget QHeaderView::vertical {
    width: 0px;
}

QHeaderView {
    background-color: rgba(112, 146, 190, 0.85); 
    border: none;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}

QHeaderView::section {
    background-color: transparent;
    color: #ffffff;
    padding: 12px 0px;
    font-weight: bold;
    font-size: 13px;
    border: none;
    text-align: center;
    min-width: 123px;
    max-width: 123px;
}

QHeaderView::section:first {
    border-top-left-radius: 12px;
}

QHeaderView::section:last {
    border-top-right-radius: 12px;
}

QTableWidget::item {
    padding: 10px;
    color: #2c3e50;
}

QTableWidget::item:hover {
    background-color: rgba(112, 146, 190, 0.15);
}

QTableWidget::item:selected {
    background-color: rgba(112, 146, 190, 0.3);
    color: #111e2e;
}

QTableWidget QScrollBar:horizontal {
    border: none;
    background: rgba(112, 146, 190, 0.2); 
    height: 10px;
    margin: 0px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

QTableWidget QScrollBar::handle:horizontal {
    background: #a6c8e0; 
    min-width: 30px;
    border-radius: 5px;
    margin: 1px;
}

QTableWidget QScrollBar::handle:horizontal:hover {
    background: #7baad0; 
}

QTableWidget QScrollBar::add-line:horizontal,
QTableWidget QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
    width: 0px;
}

QTableWidget QScrollBar::add-page:horizontal, 
QTableWidget QScrollBar::sub-page:horizontal {
    background: none;
}

QTableWidget QScrollBar:vertical {
    border: none;
    background: rgba(112, 146, 190, 0.2); 
    width: 10px;
    margin: 0px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

QTableWidget QScrollBar::handle:vertical {
    background: #a6c8e0; 
    min-height: 30px;
    border-radius: 5px;
    margin: 1px;
}

QTableWidget QScrollBar::handle:vertical:hover {
    background: #7baad0; 
}

QTableWidget QScrollBar::add-line:vertical,
QTableWidget QScrollBar::sub-line:vertical {
    height: 0px;
}

QTableWidget QScrollBar::add-page:vertical,
QTableWidget QScrollBar::sub-page:vertical {
    background: none;
}
QPushButton {
    background-color: #2c3e50; 
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 10px;
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;;
    font-size: 14px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #34495e; 
    color: #d4af37;
    font-weight: bold;
}
QPushButton:pressed {
    background-color: #1a252f;
}
QPushButton#backButton,
QPushButton#logoutButton {
    background-color: rgba(255, 255, 255, 0.6); 
    color: #2c3e50;
    border: 2px solid rgba(112, 146, 190, 0.8);
}

QPushButton#backButton:hover,
QPushButton#logoutButton:hover {
    background-color: rgba(255, 255, 255, 0.8);
    color: #000000;
}

QLabel#statusLabel {
    color: #2c3e50;
    background: rgba(255, 255, 255, 0.65);
    border: 1px solid rgba(112, 146, 190, 0.5);
    border-radius: 8px;
    padding: 5px 15px;
    font-size: 13px;
    font-weight: bold;
}

QLineEdit {
    background: rgba(255, 255, 255, 0.6);
    border: 1.5px solid rgba(112, 146, 190, 0.7);
    border-radius: 10px;
    padding: 12px 15px;
    color: #2c3e50;
    font-size: 14px;
}

QLineEdit:focus {
    background: rgba(255, 255, 255, 0.85);
    border: 2px solid #7092be;
}

#accountInfoTab QLabel, #changePasswordTab QLabel {
    color: #2c3e50;
    font-size: 14px;
    font-weight: bold;
}</string>
