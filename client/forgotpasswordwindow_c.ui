   <string notr="true">
#forgotpasswordwindow_c, #centralwidget {
    border-image: url(:/wallhaven-49kq3d.jpg) 0 0 0 0 stretch stretch;
}

QFrame#mainFrame {
    background-color: rgba(255, 255, 255, 120);  
    border: 1px solid rgba(255, 255, 255, 180);
    border-radius: 20px;                      
    padding: 25px;
}


QLabel#titleLabel {
    color: #2c3e50;
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;;
    font-size: 14pt;
    font-weight: bold;
    qproperty-alignment: 'AlignCenter';
    margin-bottom: 15px;
    background: transparent;
}

QLineEdit {
    background-color: rgba(255, 255, 255, 200);  
    border: 1px solid rgba(44, 62, 80, 60);     
    border-radius: 8px;                        
    padding: 8px 12px;
    color: #2c3e50;
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;;
    font-size: 11pt;
}

QLineEdit:focus {
    border: 2px solid #2c3e50;
    background-color: #ffffff;
}


QLabel#statusLabel {
    color: #2980b9;
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;;
    font-size: 11pt;
    qproperty-alignment: 'AlignCenter';
    margin-top: 5px;
    margin-bottom: 5px;
    background: transparent;
}


QPushButton#recoverButton {
    background-color: #2c3e50;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;;
    font-size: 11pt;
    font-weight: bold;
    padding: 8px;
    min-height: 35px;
    margin-top: 10px;
}


QPushButton#recoverButton:hover {
    background-color: #34495e;
}


QPushButton#backToLoginButton {
    background-color: transparent;
    color: #2c3e50;
    border: none;
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;;
    font-size: 10pt;
    text-decoration: underline;
    min-height: 30px;
    margin-top: 5px;
}


QPushButton#backToLoginButton:hover {
    color: #d4af37; 
}</string>
