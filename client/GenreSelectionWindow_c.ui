  <property name="styleSheet">
   <string notr="true">#GenreSelectionWindow, #centralwidget {
    border-image: url(:/wallhaven-49kq3d.jpg) 0 0 0 0 stretch stretch;
}
#widget {
    background-color: rgba(255, 255, 255, 120);  
    border: 1px solid rgba(255, 255, 255, 180);
    border-radius: 20px;
    min-width: 550px; 
    min-height: 420px;
}
QPushButton#confirmButton {
    background-color: #2c3e50;
    color: #ffffff;
    border: none;
    border-radius: 15px;
    font-family: &quot;Vazirmatn&quot;, &quot;Segoe UI&quot;, &quot;Tahoma&quot;;
    font-size: 14px;
    font-weight: bold;
    padding: 10px;
}

QPushButton#confirmButton:hover {
    background-color: #34495e;
    color: #d4af37;
}

QPushButton#confirmButton:pressed {
    background-color: #1a252f;
}
QListWidget#genresListWidget {
    background-color: rgba(255, 255, 255, 160);
    color: #2c3e50;
    border: 1px solid rgba(44, 62, 80, 50);
    border-radius: 10px;
    padding: 5px;
    font-family: &quot;Vazirmatn&quot;, &quot;Segoe UI&quot;, &quot;Tahoma&quot;;
}
QListWidget#genresListWidget::item {
    padding: 10px;
    color: #2c3e50;
    border-bottom: 1px solid rgba(44, 62, 80, 15);
    border-radius: 6px;
}

QListWidget#genresListWidget::item:hover {
    background-color: rgba(44, 62, 80, 25);
}

QListWidget#genresListWidget::item:selected {
    background-color: #2c3e50; 
    color: #ffffff;
}
QLabel {
    color: #2c3e50;
    font-family: &quot;Vazirmatn&quot;, &quot;Segoe UI&quot;, &quot;Tahoma&quot;;
    font-size: 18px;
    font-weight: bold;
    background: transparent;
}
QLabel#instructionLabel {
    color: #2c3e50;
    font-size: 14px;
    font-weight: normal;
    background: transparent;
}</string>
