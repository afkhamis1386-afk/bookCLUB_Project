    font-size: 11pt;
    qproperty-alignment: 'AlignCenter';
    margin-top: 5px;
    margin-bottom: 5px;
    background: transparent;
}
QPushButton#selectCoverButton, QPushButton#selectPdfButton {
    background-color: rgba(255, 255, 255, 180);
    color: #2c3e50;
    border: 1px solid rgba(44, 62, 80, 100);
    border-radius: 6px;
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;;
    font-size: 9pt;
    font-weight: bold;
    padding: 6px 12px;
    min-height: 28px;
}

QPushButton#selectCoverButton:hover, QPushButton#selectPdfButton:hover {
    background-color: #2c3e50;
    color: #ffffff;
    border: 1px solid #2c3e50;
}
QLabel#coverPathLabel, QLabel#pdfPathLabel {
    color: rgba(44, 62, 80, 180);
    font-style: italic;
    font-size: 9pt;
}
QPushButton#submitButton {
