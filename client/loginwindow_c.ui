}

QLineEdit {
    background-color: rgba(255, 255, 255, 0.85); 
    border: 1px solid #a0aab5; 
    border-radius: 10px;
    padding: 8px;
    font-size: 11pt;
    color: #2c3e50;
}

QLineEdit:focus {
    border: 2px solid #34495e; 
}

QPushButton#loginButton {  
    background-color: #34495e; 
    color: white;
    border-radius: 10px; 
    padding: 10px;
    font-size: 12pt;
    font-weight: bold;
}

QPushButton#loginButton:hover {
