   <string notr="true">QMainWindow#HomeWindow_c {
    background-image: url(&quot;:/wallhaven-49kq3d.jpg&quot;);
    background-position: center center;
    background-repeat: no-repeat;
}

QFrame#mainFrame {
    background-color: rgba(15, 23, 42, 0.45);  
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 20px; 
    margin: 15px; 
}

QLineEdit#searchLineEdit {
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    padding: 7px 12px;
    color: #ffffff;
    font-family: &quot;Segoe UI&quot;, &quot;Vazirmatn&quot;;
    font-size: 14px;
    font-weight: bold;
}
QLineEdit#searchLineEdit:focus {
    background-color: rgba(255, 255, 255, 0.18);
    border: 1px solid rgba(147, 197, 253, 0.8); 
}

#topBarWidget QPushButton {
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 8px;
    padding: 7px 14px; 
    color: #ffffff;
    font-family: &quot;Segoe UI&quot;, &quot;Vazirmatn&quot;;
    font-size: 13px;
    font-weight: bold; 
}
#topBarWidget QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.22);
    border: 1px solid rgba(255, 255, 255, 0.35);
}
#topBarWidget QPushButton:pressed {
    background-color: rgba(255, 255, 255, 0.05);
}

QPushButton#searchButton {
    background-color: rgba(147, 197, 253, 0.3); 
    border: 1px solid rgba(255, 255, 255, 0.3);
}
QPushButton#searchButton:hover {
    background-color: rgba(147, 197, 253, 0.45);
}

#tabsWidget QPushButton {
    background-color: transparent;
    border: none;
    border-bottom: 3px solid transparent; 
    color: #e2e8f0; 
    font-family: &quot;Segoe UI&quot;, &quot;Vazirmatn&quot;;
    font-size: 14px;
    font-weight: bold;
    padding: 8px 18px;
}
#tabsWidget QPushButton:hover {
    color: #ffffff;
    border-bottom: 3px solid rgba(255, 255, 255, 0.5);
}
#tabsWidget QPushButton:checked, #tabsWidget QPushButton:pressed {
    color: #ffffff;
    border-bottom: 3px solid #ffffff;
}

QLabel#statusLabel {
    color: #cbd5e1;
    font-family: &quot;Segoe UI&quot;, &quot;Vazirmatn&quot;;
    font-size: 13px;
    font-weight: 600;
    padding-left: 5px;
}


QScrollArea#booksScrollArea {
    background-color: rgba(255, 255, 255, 0.04);  
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 12px;
}
#booksScrollArea &gt; QWidget &gt; QWidget {
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 4px;
}
QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.25);
    border-radius: 3px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.45);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: none;
    height: 0px;
}</string>
