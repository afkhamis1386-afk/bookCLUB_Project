   <string notr="true">QMainWindow {
    background-color: #e0e5ec;
}

QLabel {
    color: #2c3e50;
    font-family: &quot;Vazirmatn&quot;, &quot;Segoe UI&quot;, &quot;Tahoma&quot;;
    font-size: 18px;
    font-weight: bold; 
    background: transparent;
}

QListWidget {
    background-color: rgba(255, 255, 255, 150);
    color: #2c3e50;
    border: 1px solid rgba(44, 62, 80, 50);
    border-radius: 10px;
    padding: 5px;
    font-family: &quot;Vazirmatn&quot;, &quot;Segoe UI&quot;, &quot;Tahoma&quot;;
    font-weight: bold;
}

QListWidget::item {
    padding: 8px;
    color: #2c3e50;
    border-radius: 6px;
}

QListWidget::item:hover {
    background-color: rgba(44, 62, 80, 20);
}

QListWidget::item:selected {
    background-color: #2c3e50;
    color: #ffffff;
}

QScrollArea {
    background-color: rgba(255, 255, 255, 50); 
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 150);
}

QScrollArea &gt; QWidget &gt; QWidget,
#scrollAreaWidgetContents {
    background-color: transparent;
}

QPushButton {
    background-color: #2c3e50;
    color: #ffffff;
    border: none;
    border-radius: 12px;
    padding: 10px;
    font-family: &quot;Vazirmatn&quot;, &quot;Segoe UI&quot;, &quot;Tahoma&quot;;
    font-size: 15px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #34495e; 
    color: #d4af37;
    font-weight: bold;
}

QPushButton:pressed {
    background-color: #1a252f;
}

QTextEdit, QComboBox {
    background-color: rgba(255, 255, 255, 150);
    color: #2c3e50;
    border: 1px solid rgba(44, 62, 80, 50);
    border-radius: 10px;
    padding: 5px;
    font-family: &quot;Vazirmatn&quot;, &quot;Segoe UI&quot;, &quot;Tahoma&quot;;
    font-weight: bold;
}

QTextEdit:focus, QComboBox:focus {
    border: 2px solid #2c3e50;
    background-color: #ffffff;
}</string>
